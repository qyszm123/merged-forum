    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.12.0",
    "pdf-parse": "^2.4.5",
    "zod": "^3.24.1"
