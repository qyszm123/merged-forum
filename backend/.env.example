PORT=3100
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=kcsquare

# Redis（可选；连不上时降级为内存限流）
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=false

# JWT（试点务必改成随机长串；生产禁止用默认值）
JWT_SECRET=change-me-kcsquare-dev-secret
JWT_EXPIRES_IN=7d

# CORS（试点前端地址）
CORS_ORIGIN=http://localhost:5173

# DeepSeek（与主系统 speech2note 共用；关卡 AI 讲解用 HOME_AI 模型）
# DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_HOME_AI_MODEL=deepseek-v4-flash
# DEEPSEEK_TIMEOUT=360000
# DEEPSEEK_HOME_AI_TIMEOUT=120000
